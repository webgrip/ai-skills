{
  "name": "webgrip",
  "displayName": "Webgrip Skills",
  "description": "The whole Webgrip skills estate as one namespaced plugin — every skill loads as webgrip:<skill>, so it can sit alongside another estate's same-named skills.",
  "version": "2.2.1",
  "license": "MIT",
  "author": {
    "name": "Webgrip",
    "url": "https://forgejo.webgrip.dev/webgrip"
  },
  "homepage": "https://forgejo.webgrip.dev/webgrip/ai-skills",
  "repository": "https://forgejo.webgrip.dev/webgrip/ai-skills",
  "keywords": [
    "agent-skills",
    "claude-code",
    "bundle",
    "namespaced"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/guard-secrets/scripts/guard_secrets.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/skill-usage/scripts/log_usage.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/domain-language/scripts/retire_nudge.py\""
          }
        ]
      }
    ]
  }
}
