{
  "uid": "careless-ledger",
  "title": "Budget ledger (careless)",
  "schemaVersion": 41,
  "timezone": "utc",
  "time": {
    "from": "now/M",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Projected end of month",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cost_projected_month_eur)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Projection of the current inventory."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Budget used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cost_month_to_date_eur) / scalar(cost_budget_eur)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Month to date over the monthly budget."
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Run-rate vs budget",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cost_monthly_run_rate_eur)"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "max": 500,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 450
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Run-rate against the 500 budget."
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Spend by team",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (team) (cost_month_to_date_eur)",
          "legendFormat": "{{team}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Share of spend per team."
    },
    {
      "id": 5,
      "type": "table",
      "title": "LLM spend by key",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "litellm-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT api_key, sum(spend) * 1.21 AS spend_incl_vat FROM \"LiteLLM_DailyUserSpend\" GROUP BY 1"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2
        },
        "overrides": []
      },
      "description": "Gross spend per key."
    }
  ]
}
