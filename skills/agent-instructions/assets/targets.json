      "hooks_file": ".github/hooks/*.json",
      "note": "copilot-setup-steps.yml (job copilot-setup-steps, timeout-minutes at most 59) runs outside the firewall; MCP servers are set in the repository settings, not in a file.",
      "docs": "https://docs.github.com/en/copilot/how-tos/use-copilot-agents/coding-agent/customize-the-agent-environment"
    },
