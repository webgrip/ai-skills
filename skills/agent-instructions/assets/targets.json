{
  "schema_version": 1,
  "defaults": {
    "rules_dir": ".ai/rules",
    "skills_dir": ".agents/skills",
    "docs_dir": "docs",
    "docs_index": "docs/index.md",
    "rule_line_limit": 20,
    "token_budget": 5000,
    "bytes_per_token": 2.9,
    "agents_md_max_bytes": 32768
  },
  "nested_instruction_names": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "flagged_files": [
    "REVIEW.md"
  ],
  "docs_sites": [
    "mkdocs.yml",
    "mkdocs.yaml",
    "docusaurus.config.js",
    "docusaurus.config.ts",
    "book.toml",
    "docs/conf.py",
    "antora.yml",
    "docs/antora.yml"
  ],
  "walk_skip": [
    ".git",
    "node_modules",
    "vendor",
    ".venv",
    "venv",
    "dist",
    "build",
    ".next",
    "target",
    "storage"
  ],
  "tools": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "category": "interactive-agent",
      "detect": [
        "CLAUDE.md",
        "CLAUDE.local.md",
        ".claude/",
        ".mcp.json"
      ],
      "instructions": [
        "CLAUDE.md",
        ".claude/CLAUDE.md",
        "CLAUDE.local.md",
        "AGENTS.md"
      ],
      "rules": {
        "format": "claude-symlink",
        "dir": ".claude/rules",
        "ext": ".md",
        "keys": {}
      },
      "skills_dir": ".claude/skills",
      "mcp_config": ".mcp.json",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": [
        ".claude/settings.json",
        ".claude/settings.local.json"
      ],
      "docs": "https://code.claude.com/docs/en/memory"
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot",
      "category": "interactive-agent",
      "detect": [
        ".github/copilot-instructions.md",
        ".github/instructions/",
        ".github/copilot/",
        ".github/hooks/",
        ".github/mcp.json",
        ".vscode/mcp.json"
      ],
      "instructions": [
        ".github/copilot-instructions.md",
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md"
      ],
      "rules": {
        "format": "copilot-applyto",
        "dir": ".github/instructions",
        "ext": ".instructions.md",
        "keys": {
          "apply_to": "applyTo",
          "separator": ",",
          "all_files": "**",
          "exclude_agent": "excludeAgent",
          "exclude_agent_values": [
            "code-review",
            "cloud-agent"
          ]
        }
      },
      "skills_dir": [
        ".github/skills",
        ".claude/skills",
        ".agents/skills"
      ],
      "mcp_config": [
        ".vscode/mcp.json",
        ".mcp.json",
        ".github/mcp.json"
      ],
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": ".github/hooks/*.json",
      "reads_hooks_from": [
        ".claude/settings.json",
        ".claude/settings.local.json"
      ],
      "docs": "https://docs.github.com/en/copilot/how-tos/configure-custom-instructions/add-repository-instructions"
    },
    {
      "id": "codex",
      "name": "OpenAI Codex",
      "category": "interactive-agent",
      "detect": [
        "AGENTS.override.md",
        ".codex/"
      ],
      "instructions": [
        "AGENTS.md",
        "AGENTS.override.md"
      ],
      "rules": null,
      "skills_dir": ".agents/skills",
      "mcp_config": ".codex/config.toml",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": ".codex/hooks.json",
      "docs": "https://learn.chatgpt.com/docs/agent-configuration/agents-md"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "category": "interactive-agent",
      "detect": [
        ".cursor/",
        ".cursorrules",
        ".cursorignore"
      ],
      "instructions": [
        "AGENTS.md",
        "CLAUDE.md",
        ".cursorrules"
      ],
      "rules": {
        "format": "cursor-mdc",
        "dir": ".cursor/rules",
        "ext": ".mdc",
        "keys": {
          "description": "description",
          "globs": "globs",
          "always_apply": "alwaysApply",
          "separator": ", "
        }
      },
      "skills_dir": [
        ".agents/skills",
        ".cursor/skills",
        ".claude/skills",
        ".codex/skills"
      ],
      "mcp_config": ".cursor/mcp.json",
      "setup_file": null,
      "ignore_file": ".cursorignore",
      "hooks_file": ".cursor/hooks.json",
      "reads_hooks_from": [
        ".claude/settings.json",
        ".claude/settings.local.json"
      ],
      "docs": "https://cursor.com/docs/rules"
    },
    {
      "id": "antigravity",
      "name": "Google Antigravity",
      "category": "interactive-agent",
      "detect": [
        ".agents/rules/",
        ".agents/mcp_config.json",
        ".agents/hooks.json",
        ".agent/"
      ],
      "instructions": [
        "AGENTS.md",
        "GEMINI.md"
      ],
      "rules": {
        "format": "trigger-globs",
        "dir": ".agents/rules",
        "ext": ".md",
        "keys": {
          "trigger": "trigger",
          "glob_trigger": "glob",
          "always_trigger": "always_on",
          "globs": "globs",
          "separator": ", ",
          "quote_globs": true
        }
      },
      "skills_dir": ".agents/skills",
      "mcp_config": ".agents/mcp_config.json",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": ".agents/hooks.json",
      "docs": "https://antigravity.google/docs/rules"
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "category": "interactive-agent",
      "detect": [
        "opencode.json",
        "opencode.jsonc",
        ".opencode/"
      ],
      "instructions": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "rules": null,
      "skills_dir": [
        ".opencode/skills",
        ".claude/skills",
        ".agents/skills"
      ],
      "mcp_config": "opencode.json",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": ".opencode/plugins/",
      "docs": "https://opencode.ai/docs/rules/"
    },
    {
      "id": "junie",
      "name": "JetBrains Junie",
      "category": "interactive-agent",
      "detect": [
        ".junie/"
      ],
      "instructions": [
        ".junie/AGENTS.md",
        "AGENTS.md",
        ".junie/playbook.md",
        ".junie/guidelines.md"
      ],
      "rules": {
        "format": null,
        "dir": ".junie/rules",
        "ext": ".md",
        "keys": {}
      },
      "skills_dir": [
        ".junie/skills",
        ".agents/skills"
      ],
      "mcp_config": ".junie/mcp/mcp.json",
      "setup_file": null,
      "ignore_file": ".aiignore",
      "hooks_file": null,
      "docs": "https://junie.jetbrains.com/docs/guidelines-and-memory.html"
    },
    {
      "id": "devin-desktop",
      "name": "Devin Desktop (formerly Windsurf)",
      "category": "interactive-agent",
      "detect": [
        ".devin/",
        ".windsurf/",
        ".windsurfrules",
        ".devinignore"
      ],
      "instructions": [
        "AGENTS.md",
        "AGENT.md",
        "AGENTS.local.md",
        ".windsurfrules",
        "CLAUDE.md"
      ],
      "rules": {
        "format": "trigger-globs",
        "dir": ".devin/rules",
        "also_dirs": [
          ".windsurf/rules"
        ],
        "ext": ".md",
        "keys": {
          "trigger": "trigger",
          "glob_trigger": "glob",
          "always_trigger": "always_on",
          "globs": "globs",
          "separator": ", ",
          "quote_globs": false
        }
      },
      "skills_dir": [
        ".agents/skills",
        ".devin/skills",
        ".windsurf/skills"
      ],
      "mcp_config": ".devin/mcp_config.json",
      "setup_file": null,
      "ignore_file": ".devinignore",
      "hooks_file": ".devin/hooks.v1.json",
      "reads_hooks_from": [
        ".claude/settings.json",
        ".claude/settings.local.json"
      ],
      "note": "the globs format (one comma-separated string) is inferred from the former Windsurf rule format that Google Antigravity documents; confirm it with a headless probe before relying on multi-glob rules.",
      "docs": "https://docs.devin.ai/desktop/cascade/memories.md"
    },
    {
      "id": "warp",
      "name": "Warp",
      "category": "interactive-agent",
      "detect": [
        "WARP.md",
        ".warp/"
      ],
      "instructions": [
        "AGENTS.md",
        "WARP.md"
      ],
      "rules": null,
      "skills_dir": [
        ".agents/skills",
        ".warp/skills"
      ],
      "mcp_config": ".warp/.mcp.json",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": null,
      "docs": "https://docs.warp.dev/agents/capabilities/rules"
    },
    {
      "id": "cline",
      "name": "Cline",
      "category": "interactive-agent",
      "detect": [
        ".clinerules",
        ".cline/",
        ".clineignore"
      ],
      "instructions": [
        "AGENTS.md",
        ".cursorrules",
        ".windsurfrules"
      ],
      "rules": {
        "format": "cline-paths",
        "dir": ".clinerules",
        "also_dirs": [
          ".cline/rules"
        ],
        "ext": ".md",
        "keys": {
          "paths": "paths"
        }
      },
      "skills_dir": [
        ".cline/skills",
        ".clinerules/skills",
        ".claude/skills",
        ".agents/skills"
      ],
      "mcp_config": null,
      "setup_file": null,
      "ignore_file": ".clineignore",
      "hooks_file": [
        ".clinerules/hooks/",
        ".cline/hooks/"
      ],
      "docs": "https://docs.cline.bot/customization/cline-rules"
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "category": "interactive-agent",
      "detect": [
        "GEMINI.md",
        ".gemini/settings.json",
        ".geminiignore"
      ],
      "instructions": [
        "GEMINI.md",
        "AGENTS.md"
      ],
      "rules": null,
      "skills_dir": [
        ".gemini/skills",
        ".agents/skills"
      ],
      "mcp_config": ".gemini/settings.json",
      "setup_file": null,
      "ignore_file": ".geminiignore",
      "hooks_file": ".gemini/settings.json",
      "note": "since 2026-06-18 Gemini CLI serves only Gemini Code Assist Standard/Enterprise and API-key users; individual accounts moved to Google Antigravity.",
      "docs": "https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/gemini-md.md"
    },
    {
      "id": "kiro",
      "name": "Kiro",
      "category": "interactive-agent",
      "detect": [
        ".kiro/"
      ],
      "instructions": [
        "AGENTS.md"
      ],
      "rules": {
        "format": "kiro-filematch",
        "dir": ".kiro/steering",
