      "instructions": [
        "CLAUDE.md"
      ],
      "rules": {
        "format": "claude-symlink",
        "dir": ".claude/rules",
        "ext": ".md",
        "keys": {}
      },
      "skills_dir": ".claude/skills",
      "mcp_config": ".mcp.json",
      "setup_file": null,
      "hooks_file": ".claude/settings.json",
      "note": "the environment and its setup script live in the Claude UI; repo SessionStart hooks can test CLAUDE_CODE_REMOTE. Whether cloud sessions read AGENTS.md without a CLAUDE.md is inferred, so keep CLAUDE.md = @AGENTS.md.",
      "docs": "https://code.claude.com/docs/en/cloud-environments"
    },
    {
      "id": "claude-code-action",
      "name": "Claude Code GitHub Action",
      "category": "cloud-agent",
      "detect": [
        {
          "file": ".github/workflows/*.yml",
