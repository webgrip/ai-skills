      "skills_dir": ".kiro/skills",
      "mcp_config": ".kiro/settings/mcp.json",
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": ".kiro/hooks/*.json",
      "docs": "https://kiro.dev/docs/steering/"
    },
    {
      "id": "jetbrains-ai-assistant",
      "name": "JetBrains AI Assistant",
      "category": "interactive-agent",
      "detect": [
        ".aiassistant/"
      ],
      "instructions": [],
      "rules": {
        "format": null,
        "dir": ".aiassistant/rules",
        "ext": ".md",
        "keys": {}
      },
      "skills_dir": null,
      "mcp_config": null,
      "setup_file": null,
      "ignore_file": null,
      "hooks_file": null,
      "docs": "https://www.jetbrains.com/help/ai-assistant/configure-project-rules.html"
    },
    {
      "id": "zed",
      "name": "Zed",
      "category": "interactive-agent",
      "detect": [
        ".rules",
        ".zed/"
      ],
      "instructions": [
        ".rules",
        "AGENT.md",
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md"
      ],
      "rules": null,
      "skills_dir": ".agents/skills",
      "mcp_config": ".zed/settings.json",
      "setup_file": null,
