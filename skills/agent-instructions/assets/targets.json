      "docs": "https://cursor.com/docs/cloud-agent"
    },
    {
      "id": "copilot-cloud-agent",
      "name": "GitHub Copilot cloud agent",
      "category": "cloud-agent",
      "detect": [
        ".github/workflows/copilot-setup-steps.yml",
        ".github/agents/"
      ],
      "instructions": [
        ".github/copilot-instructions.md",
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md"
      ],
      "rules": {
        "format": "copilot-applyto",
        "dir": ".github/instructions",
        "ext": ".instructions.md",
