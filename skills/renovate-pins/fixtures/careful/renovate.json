{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)deploy/.+/values\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(^|/)apps/.+/helmrelease\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)apps/.+/deployment\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchDepNames": [
        "ghcr.io/example/gateway"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)deploy/gateway/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository: (?<depName>ghcr\\.io/example/gateway)\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s]+)\"?\\n[ \\t]*digest: \"?(?<currentDigest>sha256:[a-f0-9]{64})\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)observability/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
